{
  "name": "tv-shows-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && npm run lint:styles && npm run format:styles:check",
    "lint:styles": "stylelint \"src/**/*.module.css\"",
    "format:styles": "prettier --write \"src/**/*.css\"",
    "format:styles:check": "prettier --check \"src/**/*.css\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss-custom-media": "^12.0.4",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
